{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageV3EKS",
      "Effect": "Allow",
      "Action": [
        "eks:CreateCluster",
        "eks:UpdateClusterConfig",
        "eks:UpdateClusterVersion",
        "eks:DeleteCluster",
        "eks:CreateNodegroup",
        "eks:UpdateNodegroupConfig",
        "eks:UpdateNodegroupVersion",
        "eks:DeleteNodegroup",
        "eks:CreateAddon",
        "eks:UpdateAddon",
        "eks:DeleteAddon",
        "eks:CreateAccessEntry",
        "eks:UpdateAccessEntry",
        "eks:DeleteAccessEntry",
        "eks:AssociateAccessPolicy",
        "eks:DisassociateAccessPolicy",
        "eks:CreatePodIdentityAssociation",
        "eks:UpdatePodIdentityAssociation",
        "eks:DeletePodIdentityAssociation",
        "eks:DescribePodIdentityAssociation",
        "eks:ListPodIdentityAssociations",
        "eks:TagResource",
        "eks:UntagResource",
        "eks:DescribeUpdate",
        "eks:ListUpdates"
      ],
      "Resource": [
        "arn:aws:eks:ap-northeast-2:919551759796:cluster/needu-v3-dev",
        "arn:aws:eks:ap-northeast-2:919551759796:nodegroup/needu-v3-dev/*",
        "arn:aws:eks:ap-northeast-2:919551759796:addon/needu-v3-dev/*",
        "arn:aws:eks:ap-northeast-2:919551759796:access-entry/needu-v3-dev/*",
        "arn:aws:eks:ap-northeast-2:919551759796:podidentityassociation/needu-v3-dev/*"
      ]
    },
    {
      "Sid": "ManageV3IAMRoles",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy"
      ],
      "Resource": [
        "arn:aws:iam::919551759796:role/needu-v3-dev-cluster-role",
        "arn:aws:iam::919551759796:role/needu-v3-dev-node-role",
        "arn:aws:iam::919551759796:role/needu-v3-dev-alb-controller",
        "arn:aws:iam::919551759796:role/needu-v3-dev-external-secrets",
        "arn:aws:iam::919551759796:role/needu-v3-dev-cluster-autoscaler",
        "arn:aws:iam::919551759796:role/needu-v3-dev-node-scheduler-role"
      ]
    },
    {
      "Sid": "ManageV3ALBControllerPolicy",
      "Effect": "Allow",
      "Action": [
        "iam:CreatePolicy",
        "iam:DeletePolicy",
        "iam:GetPolicy",
        "iam:GetPolicyVersion",
        "iam:ListPolicyVersions",
        "iam:CreatePolicyVersion",
        "iam:DeletePolicyVersion",
        "iam:TagPolicy",
        "iam:UntagPolicy"
      ],
      "Resource": "arn:aws:iam::919551759796:policy/needu-v3-dev-alb-controller"
    },
    {
      "Sid": "PassV3ClusterRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::919551759796:role/needu-v3-dev-cluster-role",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "eks.amazonaws.com"
        }
      }
    },
    {
      "Sid": "PassV3NodeRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::919551759796:role/needu-v3-dev-node-role",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ec2.amazonaws.com"
        }
      }
    },
    {
      "Sid": "PassV3ALBControllerRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::919551759796:role/needu-v3-dev-alb-controller",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "pods.eks.amazonaws.com"
        }
      }
    },
    {
      "Sid": "PassV3ExternalSecretsRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::919551759796:role/needu-v3-dev-external-secrets",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "pods.eks.amazonaws.com"
        }
      }
    },
    {
      "Sid": "PassV3ClusterAutoscalerRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::919551759796:role/needu-v3-dev-cluster-autoscaler",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "pods.eks.amazonaws.com"
        }
      }
    },
    {
      "Sid": "ManageV3NodeSchedules",
      "Effect": "Allow",
      "Action": [
        "scheduler:CreateSchedule",
        "scheduler:DeleteSchedule",
        "scheduler:GetSchedule",
        "scheduler:TagResource",
        "scheduler:UntagResource",
        "scheduler:UpdateSchedule"
      ],
      "Resource": [
        "arn:aws:scheduler:ap-northeast-2:919551759796:schedule/default/needu-v3-dev-*-night-stop",
        "arn:aws:scheduler:ap-northeast-2:919551759796:schedule/default/needu-v3-dev-*-morning-start"
      ]
    },
    {
      "Sid": "ReadV3NodeScheduleTags",
      "Effect": "Allow",
      "Action": "scheduler:ListTagsForResource",
      "Resource": "*"
    },
    {
      "Sid": "PassV3NodeSchedulerRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::919551759796:role/needu-v3-dev-node-scheduler-role",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "scheduler.amazonaws.com"
        }
      }
    },
    {
      "Sid": "CreateV3SubnetAndRouteTable",
      "Effect": "Allow",
      "Action": ["ec2:CreateSubnet", "ec2:CreateRouteTable"],
      "Resource": [
        "arn:aws:ec2:ap-northeast-2:919551759796:subnet/*",
        "arn:aws:ec2:ap-northeast-2:919551759796:route-table/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "needu",
          "aws:RequestTag/Version": "v3",
          "aws:RequestTag/Environment": "dev"
        }
      }
    },
    {
      "Sid": "UseExistingVPCForCreation",
      "Effect": "Allow",
      "Action": ["ec2:CreateSubnet", "ec2:CreateRouteTable"],
      "Resource": "arn:aws:ec2:ap-northeast-2:919551759796:vpc/vpc-0f2478c01e376b1b6"
    },
    {
      "Sid": "CreateV3EIP",
      "Effect": "Allow",
      "Action": "ec2:AllocateAddress",
      "Resource": "arn:aws:ec2:ap-northeast-2:919551759796:elastic-ip/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "needu",
          "aws:RequestTag/Version": "v3",
          "aws:RequestTag/Environment": "dev"
        }
      }
    },
    {
      "Sid": "CreateV3NATGateway",
      "Effect": "Allow",
      "Action": "ec2:CreateNatGateway",
      "Resource": [
        "arn:aws:ec2:ap-northeast-2:919551759796:natgateway/*",
        "arn:aws:ec2:ap-northeast-2:919551759796:elastic-ip/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "needu",
          "aws:RequestTag/Version": "v3",
          "aws:RequestTag/Environment": "dev"
        }
      }
    },
    {
      "Sid": "UsePublicSubnetForNAT",
      "Effect": "Allow",
      "Action": "ec2:CreateNatGateway",
      "Resource": "arn:aws:ec2:ap-northeast-2:919551759796:subnet/subnet-0d83afd6ba8e27647"
    },
    {
      "Sid": "ManageTaggedV3Network",
      "Effect": "Allow",
      "Action": [
        "ec2:DeleteSubnet",
        "ec2:DeleteRouteTable",
        "ec2:DeleteNatGateway",
        "ec2:ReleaseAddress",
        "ec2:CreateRoute",
        "ec2:ReplaceRoute",
        "ec2:DeleteRoute",
        "ec2:AssociateRouteTable",
        "ec2:DisassociateRouteTable"
      ],
      "Resource": [
        "arn:aws:ec2:ap-northeast-2:919551759796:subnet/*",
        "arn:aws:ec2:ap-northeast-2:919551759796:route-table/*",
        "arn:aws:ec2:ap-northeast-2:919551759796:natgateway/*",
        "arn:aws:ec2:ap-northeast-2:919551759796:elastic-ip/*"
      ],
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/Project": "needu",
          "ec2:ResourceTag/Version": "v3",
          "ec2:ResourceTag/Environment": "dev"
        }
      }
    },
    {
      "Sid": "TagV3ResourcesOnCreation",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": [
        "arn:aws:ec2:ap-northeast-2:919551759796:subnet/*",
        "arn:aws:ec2:ap-northeast-2:919551759796:route-table/*",
        "arn:aws:ec2:ap-northeast-2:919551759796:natgateway/*",
        "arn:aws:ec2:ap-northeast-2:919551759796:elastic-ip/*"
      ],
      "Condition": {
        "StringEquals": {
          "ec2:CreateAction": [
            "CreateSubnet",
            "CreateRouteTable",
            "CreateNatGateway",
            "AllocateAddress"
          ]
        }
      }
    },
    {
      "Sid": "ManageV3NetworkTags",
      "Effect": "Allow",
      "Action": ["ec2:CreateTags", "ec2:DeleteTags"],
      "Resource": [
        "arn:aws:ec2:ap-northeast-2:919551759796:subnet/*",
        "arn:aws:ec2:ap-northeast-2:919551759796:route-table/*",
        "arn:aws:ec2:ap-northeast-2:919551759796:natgateway/*",
        "arn:aws:ec2:ap-northeast-2:919551759796:elastic-ip/*"
      ],
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/Project": "needu",
          "ec2:ResourceTag/Version": "v3",
          "ec2:ResourceTag/Environment": "dev"
        }
      }
    },
    {
      "Sid": "ManageV3EKSSecurityGroupIngress",
      "Effect": "Allow",
      "Action": [
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupIngress"
      ],
      "Resource": "arn:aws:ec2:ap-northeast-2:919551759796:security-group/sg-01bfc1ffedbc000f3"
    },
    {
      "Sid": "CreateV3EKSSecurityGroupRule",
      "Effect": "Allow",
      "Action": "ec2:AuthorizeSecurityGroupIngress",
      "Resource": "arn:aws:ec2:ap-northeast-2:919551759796:security-group-rule/*"
    },
    {
      "Sid": "TagV3EKSSecurityGroupRuleOnCreation",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": "arn:aws:ec2:ap-northeast-2:919551759796:security-group-rule/*",
      "Condition": {
        "StringEquals": {
          "ec2:CreateAction": "AuthorizeSecurityGroupIngress"
        }
      }
    },
    {
      "Sid": "ManageV2DevRedisIngressFromV3EKS",
      "Effect": "Allow",
      "Action": [
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupIngress"
      ],
      "Resource": "arn:aws:ec2:ap-northeast-2:919551759796:security-group/sg-067a45fde040402bb"
    },
    {
      "Sid": "ManageV3ValkeySecurityGroupTags",
      "Effect": "Allow",
      "Action": ["ec2:CreateTags", "ec2:DeleteTags"],
      "Resource": [
        "arn:aws:ec2:ap-northeast-2:919551759796:security-group/sg-0a3916fa05605bb6f",
        "arn:aws:ec2:ap-northeast-2:919551759796:security-group/sg-03ccb51a12b64221b"
      ]
    },
    {
      "Sid": "ManageV3ValkeyReplicationGroupTags",
      "Effect": "Allow",
      "Action": [
        "elasticache:AddTagsToResource",
        "elasticache:RemoveTagsFromResource"
      ],
      "Resource": [
        "arn:aws:elasticache:ap-northeast-2:919551759796:replicationgroup:needu-v3-dev-valkey",
        "arn:aws:elasticache:ap-northeast-2:919551759796:replicationgroup:needu-v3-dev-valkey-a"
      ]
    }
  ]
}
