{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EC2Read",
      "Effect": "Allow",
      "Action": ["ec2:Describe*"],
      "Resource": "*"
    },
    {
      "Sid": "EKSRead",
      "Effect": "Allow",
      "Action": [
        "eks:DescribeCluster",
        "eks:ListClusters",
        "eks:DescribeNodegroup",
        "eks:ListNodegroups",
        "eks:DescribeAddon",
        "eks:ListAddons",
        "eks:DescribeAccessEntry",
        "eks:ListAccessEntries",
        "eks:ListAssociatedAccessPolicies",
        "eks:ListTagsForResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "IAMRead",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:GetRolePolicy",
        "iam:GetPolicy",
        "iam:GetPolicyVersion",
        "iam:ListInstanceProfilesForRole",
        "iam:ListRoleTags"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ElastiCacheRead",
      "Effect": "Allow",
      "Action": [
        "elasticache:DescribeReplicationGroups",
        "elasticache:DescribeCacheSubnetGroups",
        "elasticache:DescribeCacheClusters",
        "elasticache:DescribeCacheParameterGroups",
        "elasticache:ListTagsForResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AMPRead",
      "Effect": "Allow",
      "Action": [
        "aps:DescribeWorkspace",
        "aps:DescribeLoggingConfiguration",
        "aps:ListTagsForResource"
      ],
      "Resource": "arn:aws:aps:ap-northeast-2:919551759796:workspace/ws-636ab549-0b3f-4b0b-8de8-6352bec14f11"
    },
    {
      "Sid": "GrafanaRead",
      "Effect": "Allow",
      "Action": [
        "grafana:DescribeWorkspace",
        "grafana:DescribeWorkspaceConfiguration"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CloudWatchLogsRead",
      "Effect": "Allow",
      "Action": ["logs:DescribeLogGroups"],
      "Resource": "*"
    },
    {
      "Sid": "CloudWatchLogsTagRead",
      "Effect": "Allow",
      "Action": ["logs:ListTagsForResource"],
      "Resource": [
        "arn:aws:logs:ap-northeast-2:919551759796:log-group:/needu/v3/dev/eks/application",
        "arn:aws:logs:ap-northeast-2:919551759796:log-group:/aws/lambda/needu-v3-dev-discord-notifier"
      ]
    },
    {
      "Sid": "SNSRead",
      "Effect": "Allow",
      "Action": [
        "sns:GetTopicAttributes",
        "sns:ListTagsForResource",
        "sns:ListSubscriptionsByTopic",
        "sns:GetSubscriptionAttributes"
      ],
      "Resource": "arn:aws:sns:ap-northeast-2:919551759796:needu-v3-dev-alerts"
    },
    {
      "Sid": "SecretsManagerRead",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:DescribeSecret",
        "secretsmanager:GetResourcePolicy"
      ],
      "Resource": "arn:aws:secretsmanager:ap-northeast-2:919551759796:secret:needu/v3/dev/discord-webhook-*"
    },
    {
      "Sid": "LambdaRead",
      "Effect": "Allow",
      "Action": [
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration",
        "lambda:GetPolicy",
        "lambda:ListTags",
        "lambda:ListVersionsByFunction"
      ],
      "Resource": "arn:aws:lambda:ap-northeast-2:919551759796:function:needu-v3-dev-discord-notifier"
    }
  ]
}
