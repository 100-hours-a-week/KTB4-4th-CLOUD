environment = "prod"
public_subnets = {
  a = { az = "ap-northeast-2a", cidr = "10.1.16.0/24" }
  c = { az = "ap-northeast-2c", cidr = "10.1.17.0/24" }
}
db_subnets = {
  a = { az = "ap-northeast-2a", cidr = "10.1.20.0/24" }
  c = { az = "ap-northeast-2c", cidr = "10.1.21.0/24" }
}
certificate_arn = "arn:aws:acm:ap-northeast-2:ACCOUNT_ID:certificate/REPLACE"
hosted_zone_id = "Z_REPLACE"
domain_name = "v2.needu.gift" # V1 운영 DNS 전환 전 확인용 도메인
ecr_repository_urls = {
  frontend = "ACCOUNT_ID.dkr.ecr.ap-northeast-2.amazonaws.com/need-u/frontend"
  backend  = "ACCOUNT_ID.dkr.ecr.ap-northeast-2.amazonaws.com/need-u/backend"
  ai       = "ACCOUNT_ID.dkr.ecr.ap-northeast-2.amazonaws.com/need-u/ai"
}
image_tags = { frontend = "REPLACE_SHA", backend = "REPLACE_SHA", ai = "REPLACE_SHA" }
mysql_engine_version = "8.4.11"
postgres_engine_version = "18.6" # pgvector 0.8.2 지원 버전
mysql_instance_class = "db.t4g.medium"
postgres_instance_class = "db.t4g.small"
mysql_storage_gb = 50
postgres_storage_gb = 20
redis_node_type = "cache.t4g.small"
redis_num_nodes = 1
task_cpu = { frontend = 512, backend = 1024, ai = 512 }
task_memory = { frontend = 1024, backend = 2048, ai = 1024 }
task_desired_count = 2
autoscaling_min = 2
autoscaling_max = 4
multi_az = false
deletion_protection = true
db_backup_retention_days = 7
github_repository = "OWNER/REPOSITORY"
github_oidc_provider_arn = "arn:aws:iam::ACCOUNT_ID:oidc-provider/token.actions.githubusercontent.com"
# 실제 값은 AWS의 /needu/v2/prod 경로에 별도 등록하고 여기에는 Parameter 경로만 작성
app_secret_parameters = { frontend = {}, backend = {}, ai = {} }

# 정상 배포 트래픽을 확인한 뒤 조정
deployment_5xx_threshold = 5

# AI 팀 실행 명령 확정 전에는 빈 값으로 유지
catalog_commands = {}
